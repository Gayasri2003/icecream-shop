<Window x:Class="IceCreamShop.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Ice Cream Shop Management System"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#0f172a"
        Foreground="#f8fafc"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Button Styles -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3b82f6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563eb"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#e2e8f0"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#475569"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#ef4444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#dc2626"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RoleQuickButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1e293b"/>
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="#f8fafc"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#f8fafc"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#f8fafc"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1e293b"/>
            <Setter Property="Foreground" Value="#f1f5f9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="#1e293b"/>
            <Setter Property="AlternatingRowBackground" Value="#182234"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#334155"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="RowHeight" Value="42"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0f172a"/>
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2563eb"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Input Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1e293b"/>
            <Setter Property="Foreground" Value="#f8fafc"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#1e293b"/>
            <Setter Property="Foreground" Value="#f8fafc"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- SCREEN 1: LOGIN VIEW -->
        <Grid x:Name="LoginViewGrid" Visibility="Visible">
            <Border Width="450" Padding="35" Background="#1e293b" CornerRadius="12"
                    BorderBrush="#334155" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <!-- Brand Icon & Heading -->
                    <TextBlock Text="🍦" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="Ice Cream Shop" FontSize="24" FontWeight="Bold" Foreground="#f8fafc" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                    <!-- Error Alert Banner -->
                    <Border x:Name="LoginErrorBanner" Background="#450a0a" BorderBrush="#dc2626" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16" Visibility="Collapsed">
                        <TextBlock x:Name="LoginErrorMessage" Text="Invalid credentials" Foreground="#fca5a5" TextWrapping="Wrap" FontSize="13"/>
                    </Border>

                    <!-- Email Input -->
                    <TextBlock Text="Email Address" Foreground="#cbd5e1" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="LoginEmailTextBox" Margin="0,0,0,16"/>

                    <!-- Password Input -->
                    <TextBlock Text="Password" Foreground="#cbd5e1" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="LoginPasswordBox" Margin="0,0,0,20"/>

                    <!-- Login Button -->
                    <Button x:Name="LoginButton" Content="Sign In" Style="{StaticResource PrimaryButtonStyle}" Height="42" Click="OnLoginClicked"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- SCREEN 2: MAIN DASHBOARD VIEW -->
        <Grid x:Name="MainDashboardGrid" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/> <!-- Top Navigation -->
                <RowDefinition Height="Auto"/> <!-- Toast / Alert bar -->
                <RowDefinition Height="*"/>  <!-- Main Content -->
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="#1e293b" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand / App Name -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🍦" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Ice Cream Shop" FontSize="18" FontWeight="Bold" Foreground="#f8fafc" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Navigation Tabs -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <RadioButton x:Name="InventoryTabRadio" Content="📦 Inventory Items" IsChecked="True"
                                     Checked="OnInventoryTabSelected" GroupName="NavTabs"
                                     Style="{StaticResource TabRadioStyle}"/>
                        <RadioButton x:Name="CustomersTabRadio" Content="👥 Customer Records"
                                     Checked="OnCustomersTabSelected" GroupName="NavTabs"
                                     Style="{StaticResource TabRadioStyle}"/>
                    </StackPanel>

                    <!-- User Pill & Sign Out -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#334155" CornerRadius="16" Padding="12,5" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="UserDisplayNameText" Text="Shop Owner" FontWeight="SemiBold" Foreground="#f8fafc" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border x:Name="RoleBadgeBorder" Background="#8b5cf6" CornerRadius="10" Padding="8,2">
                                    <TextBlock x:Name="RoleBadgeText" Text="OWNER" FontWeight="Bold" FontSize="10" Foreground="White"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Button Content="Sign Out" Style="{StaticResource SecondaryButtonStyle}" Click="OnLogoutClicked"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Notification Toast Bar -->
            <Border Grid.Row="1" x:Name="ToastBanner" Background="#065f46" BorderBrush="#10b981" BorderThickness="0,0,0,1" Padding="14,10" Visibility="Collapsed">
                <Grid>
                    <TextBlock x:Name="ToastMessageText" Text="Operation completed successfully." Foreground="#d1fae5" FontWeight="SemiBold" FontSize="13"/>
                    <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" Foreground="#a7f3d0" BorderThickness="0" Cursor="Hand" Click="OnDismissToastClicked"/>
                </Grid>
            </Border>

            <!-- Main Tab Content Container -->
            <Grid Grid.Row="2" Margin="25,20,25,20">

                <!-- INVENTORY MANAGEMENT VIEW -->
                <Grid x:Name="InventoryPanel" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Filters & Actions -->
                        <RowDefinition Height="*"/>  <!-- Items Grid -->
                    </Grid.RowDefinitions>

                    <!-- Controls Toolbar -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Box -->
                        <TextBox Grid.Column="0" x:Name="ItemSearchBox" ToolTip="Search by ice cream item name" KeyDown="OnItemSearchKeyDown"/>

                        <!-- Flavor Category Dropdown -->
                        <ComboBox Grid.Column="1" x:Name="ItemCategoryFilterCombo" Margin="10,0,0,0" SelectionChanged="OnCategoryFilterChanged">
                            <ComboBoxItem Content="All Flavors" IsSelected="True"/>
                            <ComboBoxItem Content="Chocolate"/>
                            <ComboBoxItem Content="Vanilla"/>
                            <ComboBoxItem Content="Strawberry"/>
                        </ComboBox>

                        <!-- Search Button -->
                        <Button Grid.Column="2" Content="Search" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="OnItemSearchClicked"/>

                        <!-- Add Item Button -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                            <Button Content="🔄 Refresh" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="OnRefreshItemsClicked"/>
                            <Button x:Name="AddItemButton" Content="➕ Add New Item" Style="{StaticResource PrimaryButtonStyle}" Click="OnAddNewItemClicked"/>
                        </StackPanel>
                    </Grid>

                    <!-- Items DataGrid -->
                    <DataGrid Grid.Row="1" x:Name="ItemsDataGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Item Name" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="Flavor / Category" Binding="{Binding Category}" Width="1.2*"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding PriceFormatted}" Width="100"/>
                            <DataGridTextColumn Header="Stock Quantity" Binding="{Binding Quantity}" Width="120"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="3*"/>
                            <DataGridTemplateColumn Header="Actions" Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="✏️ Edit" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,8,0" Click="OnEditItemRowClicked" Tag="{Binding}"/>
                                            <Button Content="🗑️ Delete" Style="{StaticResource DangerButtonStyle}" Padding="10,4" Click="OnDeleteItemRowClicked" Tag="{Binding}"
                                                    Loaded="OnDeleteButtonLoaded"
                                                    Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CanDelete, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- CUSTOMER MANAGEMENT VIEW -->
                <Grid x:Name="CustomersPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Filters & Actions -->
                        <RowDefinition Height="*"/>  <!-- Customers Grid -->
                    </Grid.RowDefinitions>

                    <!-- Controls Toolbar -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Box -->
                        <TextBox Grid.Column="0" x:Name="CustomerSearchBox" ToolTip="Search by name, email, or phone" KeyDown="OnCustomerSearchKeyDown"/>
                        <Button Grid.Column="1" Content="Search" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="OnCustomerSearchClicked"/>

                        <!-- Actions -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Content="🔄 Refresh" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="OnRefreshCustomersClicked"/>
                            <Button Content="➕ Add Customer" Style="{StaticResource PrimaryButtonStyle}" Click="OnAddNewCustomerClicked"/>
                        </StackPanel>
                    </Grid>

                    <!-- Customers DataGrid -->
                    <DataGrid Grid.Row="1" x:Name="CustomersDataGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Customer Name" Binding="{Binding Name}" Width="1.5*"/>
                            <DataGridTextColumn Header="Email Address" Binding="{Binding Email}" Width="2*"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="130"/>
                            <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="2.5*"/>
                            <DataGridTemplateColumn Header="Actions" Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="✏️ Edit" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,8,0" Click="OnEditCustomerRowClicked" Tag="{Binding}"/>
                                            <Button Content="🗑️ Delete" Style="{StaticResource DangerButtonStyle}" Padding="10,4" Click="OnDeleteCustomerRowClicked" Tag="{Binding}"
                                                    Loaded="OnDeleteButtonLoaded"
                                                    Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CanDelete, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

            </Grid>
        </Grid>

        <!-- MODAL DIALOG OVERLAY (Item Add/Edit) -->
        <Grid x:Name="ItemModalOverlay" Visibility="Collapsed" Background="#aa000000">
            <Border Width="480" Background="#1e293b" CornerRadius="10" BorderBrush="#334155" BorderThickness="1" Padding="25" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="ItemModalTitle" Text="Add New Inventory Item" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <TextBlock Text="Product Name *" Foreground="#cbd5e1" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="ItemFormNameTextBox" Margin="0,0,0,12"/>

                    <TextBlock Text="Flavor / Category *" Foreground="#cbd5e1" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ItemFormCategoryCombo" Margin="0,0,0,12">
                        <ComboBoxItem Content="Chocolate" IsSelected="True"/>
                        <ComboBoxItem Content="Vanilla"/>
                        <ComboBoxItem Content="Strawberry"/>
                    </ComboBox>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Price ($) *" Foreground="#cbd5e1" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="ItemFormPriceTextBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Stock Quantity *" Foreground="#cbd5e1" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="ItemFormQuantityTextBox"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Description" Foreground="#cbd5e1" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="ItemFormDescTextBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="OnCancelItemModalClicked"/>
                        <Button x:Name="SaveItemButton" Content="Save Item" Style="{StaticResource PrimaryButtonStyle}" Click="OnSaveItemFormClicked"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL DIALOG OVERLAY (Customer Add/Edit) -->
        <Grid x:Name="CustomerModalOverlay" Visibility="Collapsed" Background="#aa000000">
            <Border Width="480" Background="#1e293b" CornerRadius="10" BorderBrush="#334155" BorderThickness="1" Padding="25" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="CustomerModalTitle" Text="Add New Customer" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <TextBlock Text="Full Name *" Foreground="#cbd5e1" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="CustomerFormNameTextBox" Margin="0,0,0,12"/>

                    <TextBlock Text="Email Address *" Foreground="#cbd5e1" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="CustomerFormEmailTextBox" Margin="0,0,0,12"/>

                    <TextBlock Text="Phone Number" Foreground="#cbd5e1" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="CustomerFormPhoneTextBox" Margin="0,0,0,12"/>

                    <TextBlock Text="Address" Foreground="#cbd5e1" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="CustomerFormAddressTextBox" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="OnCancelCustomerModalClicked"/>
                        <Button x:Name="SaveCustomerButton" Content="Save Customer" Style="{StaticResource PrimaryButtonStyle}" Click="OnSaveCustomerFormClicked"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
